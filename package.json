{
  "name": "chris-delgado-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate-projects.mjs && astro check && astro build && node scripts/validate-site.mjs",
    "check": "node scripts/validate-projects.mjs && astro check",
    "preview": "astro preview",
    "deploy:check": "node scripts/validate-site.mjs && wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "astro": "7.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  }
}
