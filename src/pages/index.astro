---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const toolGroups = [
  {
    label: "Data + analysis",
    accent: "var(--blue)",
    tools: ["SQL", "Python", "pandas", "SQLite", "PostgreSQL", "Power BI", "Excel", "Power Query"],
  },
  {
    label: "Building things",
    accent: "var(--accent)",
    tools: ["Reflex", "HTML/CSS", "CLI tools", "Data modeling", "Automation", "ReportLab"],
  },
  {
    label: "Quality + delivery",
    accent: "var(--purple)",
    tools: ["pytest", "unittest", "Git", "Docker", "Cloud Run", "Cloud Build", "Validation checks"],
  },
];
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <div class="availability"><span></span> Building practical things with data + Python</div>
      <h1>
        Hi, I'm Chris.<br />
        I make <em>data</em> make sense.
      </h1>
      <p class="hero-lead">
        I'm a <strong>Data Analyst and Python developer</strong> who turns raw data,
        awkward workflows, and real-world problems into clear answers and working tools.
      </p>
      <div class="button-row">
        <a class="button button-primary" href="/ai-cost-efficiency/">Open AI dashboard <span aria-hidden="true">→</span></a>
        <a class="button" href="/resume/chris-delgado-resume-2026.pdf" download="Chris Delgado Resume 2026.pdf">Download resume <span aria-hidden="true">↓</span></a>
        <a class="button" href="https://github.com/GlassHouse97" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <p class="alternate-resume">Need the editable version? <a href="/resume/chris-delgado-resume-2026.docx" download="Chris Delgado Resume 2026.docx">Download the Word file.</a></p>
    </div>

    <div class="hero-board" aria-label="Highlights from Chris's portfolio">
      <div class="board-label">Featured: AI cost efficiency</div>
      <div class="signal-card signal-data">
        <span class="signal-icon" aria-hidden="true">↗</span>
        <small>Synthetic case · Campaign 1</small>
        <strong>+$4.5k</strong>
        <span>Net AI value<br />modeled time value · not cash savings</span>
      </div>
      <div class="signal-card signal-build">
        <span class="signal-icon" aria-hidden="true">📊</span>
        <small>Analyzed</small>
        <strong>3.7M</strong>
        <span>distributor transaction rows</span>
      </div>
      <div class="signal-card signal-logic">
        <span class="signal-icon" aria-hidden="true">🎯</span>
        <small>Validated</small>
        <strong>30</strong>
        <span>games per division</span>
      </div>
      <div class="terminal-card" aria-hidden="true">
        <div class="terminal-top"><i></i><i></i><i></i></div>
        <code><span>problem</span> → model → validate → <b>useful</b></code>
      </div>
    </div>
  </section>

  <section id="work" class="section work-section shell">
    <span class="section-kicker">Selected work</span>
    <h2 class="section-heading">From a business question to a working answer.</h2>
    <p class="section-intro">
      Start with an interactive look at AI cost and time value. Explore the assumptions,
      trace the calculations, then see more of my analysis, application, and automation work.
    </p>

    <ProjectCard
      index="01 / Featured dashboard"
      emoji="↗"
      title="AI Cost Efficiency"
      summary="Does AI earn back its cost? Explore four fictional campaigns through token spend, Net AI value, campaign results, and a baseline sensitivity test. A completed dashboard, reproducible analysis, and two learner tracks make every result inspectable."
      href="/projects/ai-cost-efficiency/"
      repo="https://github.com/GlassHouse97/AI-Cost-Efficiency-Portfolio-Project"
      live="/ai-cost-efficiency/"
      liveLabel="Open dashboard"
      accent="#79e0ba"
      skills={["Python", "SQL", "Data modeling", "Interactive dashboard", "ROI analysis"]}
    >
      <div slot="preview" class="ai-preview">
        <div class="ai-preview-top"><span>MRU / AI COST EFFICIENCY</span><small>Synthetic case study</small></div>
        <h4>Same tool.<br /><em>Different outcomes.</em></h4>
        <div class="ai-outcomes">
          <div class="ai-outcome positive"><span>Campaign 1</span><strong>+$4,500</strong><small>Net AI value</small><i aria-hidden="true"></i><b>100 hours saved</b></div>
          <div class="ai-outcome negative"><span>Campaign 2</span><strong>−$4,900</strong><small>Net AI value</small><i aria-hidden="true"></i><b>70 extra hours</b></div>
        </div>
        <p>$50/hour time value · AI costs included · not cash savings</p>
      </div>
    </ProjectCard>

    <ProjectCard
      index="02 / Analytics"
      emoji="📊"
      title="Revenue Quality & Customer Profitability"
      summary="A reproducible analysis of 3.7 million anonymized transactions, from raw annual files to a validated SQLite model and executive-ready business story."
      href="/projects/distributor-case-study/"
      repo="https://github.com/GlassHouse97/Distributor-Company-Case-Study"
      live="https://github.com/GlassHouse97/Distributor-Company-Case-Study/blob/main/SOLUTION/EXECUTIVE_SUMMARY.md"
      liveLabel="View live case study"
      accent="#7cc8ff"
      skills={["SQL", "Python", "pandas", "SQLite", "Business analysis"]}
    >
      <div slot="preview" class="chart-preview">
        <div class="preview-window">
          <div class="preview-bar"><span></span><span></span><span></span><small>revenue_quality.ipynb</small></div>
          <img src="/assets/distributor/01_revenue_margin_trends.png" alt="Revenue, gross profit, and margin trend chart from the distributor case study" width="1100" height="620" />
        </div>
      </div>
    </ProjectCard>

    <ProjectCard
      index="03 / Application"
      emoji="🐉"
      title="DND and Beyond"
      summary="A personal full-stack Python project built to demonstrate my technical range through calculated character sheets, persistent campaigns, initiative, and production deployment."
      href="/projects/dnd-and-beyond/"
      repo="https://github.com/GlassHouse97/DND-And-Beyond"
      accent="#a8b4ff"
      skills={["Python", "Reflex", "PostgreSQL", "Docker", "Cloud Run"]}
    >
      <div slot="preview" class="dnd-preview" aria-label="A stylized representation of the DND and Beyond campaign interface">
        <div class="app-frame">
          <div class="app-top"><span>EMBERFALL</span><small>Session 12</small></div>
          <div class="app-grid">
            <div class="party-panel">
              <p>Party status</p>
              <div class="party-row"><i class="avatar purple">A</i><span><b>Ayla</b><small>Ranger · Level 6</small></span><strong>42 / 48</strong></div>
              <div class="party-row"><i class="avatar azure">B</i><span><b>Bram</b><small>Cleric · Level 6</small></span><strong>51 / 51</strong></div>
              <div class="party-row"><i class="avatar gold">T</i><span><b>Thorne</b><small>Wizard · Level 6</small></span><strong>24 / 32</strong></div>
            </div>
            <div class="initiative-panel">
              <p>Initiative</p>
              <div class="turn active"><b>01</b><span>Thorne</span><small>18</small></div>
              <div class="turn"><b>02</b><span>Owlbear</span><small>15</small></div>
              <div class="turn"><b>03</b><span>Ayla</span><small>12</small></div>
            </div>
          </div>
        </div>
      </div>
    </ProjectCard>

    <ProjectCard
      index="04 / Automation"
      emoji="🎯"
      title="Dart League Schedule & Standings"
      summary="Another personal Python project built around a real league problem, showing how I turn messy rules and scheduling constraints into reliable tools people can actually use."
      href="/projects/darts-league/"
      repo="https://github.com/GlassHouse97/Darts-League-Schedule"
      accent="#ff8f80"
      skills={["Python", "Constraint logic", "Playwright", "JSON", "ReportLab"]}
    >
      <div slot="preview" class="schedule-preview">
        <div class="paper-stack paper-back"></div>
        <div class="paper-stack paper-front">
          <img src="/assets/darts/darts-schedule.png" alt="Generated darts league standings and schedule report" width="1224" height="1584" />
        </div>
      </div>
    </ProjectCard>
  </section>

  <section id="about" class="section about-section">
    <div class="shell about-grid">
      <div>
        <span class="section-kicker">About me</span>
        <h2>Analysis brain.<br />Builder energy.</h2>
      </div>

      <div class="about-copy">
        <p class="about-lead">
          I like projects that start with <strong>“there has to be a better way”</strong>
          and end with something reliable enough to hand to another person.
        </p>
        <p>
          I like the part of analysis where the question is still a little fuzzy and the data doesn’t quite cooperate. That’s usually where the interesting work starts. I figure out what matters, check the assumptions, and make sure the answer holds up before anyone acts on it. SQL and Python are my usual tools, but the goal is never just to write a clever query or script.
        </p>
        <p>
          I also have a hard time ignoring a clunky process once I know it can be better. If a report is too manual, a workflow is hard to trust, or people keep solving the same problem by hand, I want to fix it. I care about work that’s accurate, easy to understand, and still useful after I hand it off.
        </p>
        <aside class="personality-note">
          <span aria-hidden="true">🧪</span>
          <p><strong>Personal operating principle.</strong> Never trust an output until it has survived at least one validation check and one skeptical look.</p>
        </aside>
      </div>
    </div>
  </section>

  <section id="toolbox" class="section toolbox-section shell">
    <span class="section-kicker">My toolbox</span>
    <h2 class="section-heading">Useful tools, chosen for the problem.</h2>
    <p class="section-intro">No percentage bars. No “95% fluent in Python.” Just the things I use to get from question to answer.</p>

    <div class="tool-grid">
      {toolGroups.map((group) => (
        <article class="tool-card" style={`--tool-accent: ${group.accent}`}>
          <div class="tool-card-top"><span></span><small>{group.label}</small></div>
          <ul>
            {group.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section credentials-section">
    <div class="shell credentials-grid">
      <div>
        <span class="section-kicker">Credentials</span>
        <h2>Certified, then put to work.</h2>
      </div>
      <div class="credential-list">
        <a href="https://learn.microsoft.com/en-us/users/christopherdelgado-8682/credentials/e71ac6697ff6dc47" target="_blank" rel="noreferrer">
          <span class="credential-year">2025</span>
          <span><strong>Microsoft Power BI Data Analyst Associate</strong><small>PL-300 certification</small></span>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="https://www.coursera.org/account/accomplishments/professional-cert/PTKFJQNWET7F" target="_blank" rel="noreferrer">
          <span class="credential-year">2023</span>
          <span><strong>Google Data Analytics Professional Certificate</strong><small>Coursera professional certificate</small></span>
          <b aria-hidden="true">↗</b>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(380px, 0.92fr);
    min-height: calc(100vh - 76px);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
    padding-block: clamp(70px, 10vw, 140px);
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.7rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .availability span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 6px rgba(110, 168, 254, 0.14);
    animation: pulse 2.8s ease-in-out infinite;
  }

  h1 {
    margin-bottom: 1.8rem;
  }

  .hero h1 {
    font-size: clamp(3rem, 5.6vw, 5.4rem);
  }

  h1 em {
    color: var(--accent);
    font-weight: 500;
  }

  .hero-lead {
    max-width: 700px;
    margin-bottom: 2rem;
    color: var(--ink-muted);
    font-size: clamp(1.12rem, 2vw, 1.38rem);
  }

  .hero-lead strong {
    color: var(--ink);
  }

  .alternate-resume {
    margin: 0.9rem 0 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .alternate-resume a {
    color: var(--accent);
    font-weight: 700;
  }

  .hero-board {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    min-height: 560px;
    padding: 52px 20px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      rgba(11, 23, 41, 0.86);
    background-size: 28px 28px;
    box-shadow: var(--shadow);
    transform: rotate(1.5deg);
  }

  .board-label {
    position: absolute;
    top: 16px;
    left: 20px;
    color: #73798b;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .signal-card,
  .terminal-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
    padding: 1.35rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(7, 10, 18, 0.83);
  }

  .signal-data {
    grid-row: span 2;
    color: var(--blue);
  }

  .signal-build {
    color: var(--purple);
  }

  .signal-logic {
    color: var(--coral);
  }

  .signal-icon {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 1.7rem;
  }

  .signal-card small {
    margin-bottom: auto;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
  }

  .signal-card strong {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 7vw, 6.2rem);
    font-weight: 500;
    line-height: 0.9;
  }

  .signal-build strong,
  .signal-logic strong {
    font-size: clamp(2.8rem, 5vw, 4.4rem);
  }

  .signal-data strong {
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    letter-spacing: -0.04em;
  }

  .signal-card > span:last-child {
    margin-top: 0.6rem;
    color: var(--ink-muted);
    font-size: 0.8rem;
  }

  .terminal-card {
    grid-column: 1 / -1;
    min-height: 112px;
    justify-content: center;
  }

  .terminal-top {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    gap: 5px;
  }

  .terminal-top i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #43495a;
  }

  .terminal-card code {
    margin-top: 20px;
    color: var(--ink-muted);
    font-size: clamp(0.68rem, 1.5vw, 0.86rem);
    white-space: nowrap;
  }

  .terminal-card code span {
    color: var(--coral);
  }

  .terminal-card code b {
    color: var(--accent);
  }

  .work-section {
    padding-top: clamp(90px, 12vw, 160px);
  }

  .work-section > .section-heading {
    max-width: 760px;
    font-size: clamp(2.15rem, 4vw, 3.75rem);
  }

  .about-section h2,
  .toolbox-section > .section-heading,
  .credentials-section h2 {
    font-size: clamp(2.15rem, 4vw, 3.75rem);
  }

  .chart-preview {
    width: 100%;
    padding: clamp(1.2rem, 4vw, 3rem);
  }

  .ai-preview {
    width: 100%;
    padding: clamp(1.4rem, 3vw, 2.5rem);
  }

  .ai-preview-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: space-between;
    color: #79e0ba;
    font-family: var(--font-mono);
    font-size: 0.59rem;
    letter-spacing: 0.04em;
  }

  .ai-preview-top small { color: var(--ink-muted); font-size: inherit; }

  .ai-preview h4 {
    margin: 2rem 0 1.8rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 500;
    line-height: 1.1;
  }

  .ai-preview h4 em { color: #79e0ba; }

  .ai-outcomes { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }

  .ai-outcome {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(7, 17, 31, 0.8);
  }

  .ai-outcome > span { color: var(--ink-muted); font-size: 0.73rem; }
  .ai-outcome strong { margin-top: 0.7rem; font-size: clamp(1.35rem, 2.3vw, 2rem); font-variant-numeric: tabular-nums; }
  .ai-outcome small { margin-top: 0.2rem; color: var(--ink-muted); font-size: 0.62rem; }
  .ai-outcome i { display: block; width: 88%; height: 5px; margin: 1.1rem 0 0.65rem; border-radius: 5px; background: currentColor; }
  .ai-outcome b { font-size: 0.65rem; font-weight: 500; }
  .ai-outcome.positive { color: #79e0ba; }
  .ai-outcome.negative { color: #ff9b90; }
  .ai-outcome.negative i { width: 96%; }
  .ai-preview > p { margin: 1rem 0 0; color: var(--ink-muted); font-size: 0.62rem; }

  .preview-window {
    overflow: hidden;
    border: 1px solid rgba(118, 215, 255, 0.3);
    border-radius: 14px;
    background: white;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.38);
    transform: rotate(-2deg);
  }

  .preview-window img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  .preview-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 10px;
    color: #777;
    background: #eff2f4;
  }

  .preview-bar span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #bfc6ca;
  }

  .preview-bar small {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.55rem;
  }

  .dnd-preview {
    width: 100%;
    padding: clamp(1rem, 4vw, 2.5rem);
  }

  .app-frame {
    overflow: hidden;
    border: 1px solid rgba(168, 180, 255, 0.36);
    border-radius: 18px;
    background: #111c33;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
    transform: rotate(1.5deg);
  }

  .app-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--purple);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .app-top small {
    color: #89839c;
    letter-spacing: 0;
  }

  .app-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 10px;
    padding: 10px;
  }

  .party-panel,
  .initiative-panel {
    padding: 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: rgba(5, 5, 10, 0.25);
  }

  .party-panel > p,
  .initiative-panel > p {
    margin-bottom: 0.8rem;
    color: #8e889f;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .party-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.55rem;
    align-items: center;
    padding-block: 0.7rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .party-row span {
    display: grid;
  }

  .party-row b,
  .turn span {
    font-size: 0.7rem;
  }

  .party-row small {
    color: #777285;
    font-size: 0.5rem;
  }

  .party-row strong {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.55rem;
  }

  .avatar {
    display: grid;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-style: normal;
    font-weight: 800;
    place-items: center;
  }

  .purple { color: #e1e5ff; background: rgba(168, 180, 255, 0.22); }
  .azure { color: #d8ecff; background: rgba(110, 168, 254, 0.2); }
  .gold { color: #ffe6a8; background: rgba(245, 201, 104, 0.19); }

  .turn {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.4rem;
    align-items: center;
    padding: 0.7rem 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    color: #a6a1b3;
  }

  .turn b,
  .turn small {
    color: #6e687b;
    font-family: var(--font-mono);
    font-size: 0.52rem;
  }

  .turn.active {
    border-radius: 7px;
    color: white;
    background: rgba(184, 165, 255, 0.13);
  }

  .schedule-preview {
    position: relative;
    width: 100%;
    min-height: 100%;
    padding: 2.2rem;
  }

  .paper-stack {
    position: absolute;
    width: min(72%, 390px);
    aspect-ratio: 8.5 / 11;
    border-radius: 4px;
    background: white;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }

  .paper-back {
    top: 18%;
    left: 18%;
    opacity: 0.45;
    transform: rotate(-8deg);
  }

  .paper-front {
    top: 10%;
    left: 23%;
    overflow: hidden;
    transform: rotate(4deg);
  }

  .paper-front img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .about-section {
    border-block: 1px solid var(--line);
    background: #edf4fc;
    color: #14243a;
  }

  .about-section :global(.section-kicker) {
    color: #3b6f9c;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 9vw, 9rem);
  }

  .about-grid h2 {
    color: #132238;
  }

  .about-copy > p {
    color: #52657b;
  }

  .about-copy .about-lead {
    color: #18304d;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    line-height: 1.35;
  }

