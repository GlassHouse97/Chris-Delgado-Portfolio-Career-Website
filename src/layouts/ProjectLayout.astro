---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  emoji: string;
  repo: string;
  accent: string;
  showStats?: boolean;
  primaryHref?: string;
  primaryLabel?: string;
}

const {
  title, description, eyebrow, emoji, repo, accent, showStats = true,
  primaryHref = repo, primaryLabel = "View on GitHub",
} = Astro.props;
const primaryExternal = primaryHref.startsWith("https://");
---

<BaseLayout title={`${title} | Chris Delgado`} description={description}>
  <article class="project-page" style={`--project-accent: ${accent}`}>
    <header class="project-hero shell">
      <a class="back-link" href="/#work"><span aria-hidden="true">←</span> All projects</a>
      <div class="hero-grid">
        <div>
          <span class="eyebrow">{eyebrow}</span>
          <h1><span aria-hidden="true">{emoji}</span> {title}</h1>
          <p class="hero-description">{description}</p>
          <div class="button-row">
            <a class="button button-primary" href={primaryHref} target={primaryExternal ? "_blank" : undefined} rel={primaryExternal ? "noreferrer" : undefined}>{primaryLabel} <span aria-hidden="true">{primaryExternal ? "↗" : "→"}</span></a>
            <slot name="hero-action" />
          </div>
        </div>
        <div class="hero-visual">
          <slot name="hero-visual" />
        </div>
      </div>
    </header>

    {
      showStats && (
        <div class="stats-band">
          <div class="shell stats-grid">
            <slot name="stats" />
          </div>
        </div>
      )
    }

    <div class="project-body shell">
      <slot />
    </div>

    <nav class="project-nav shell" aria-label="Portfolio projects">
      <a href="/#work"><span>Explore</span><strong>All projects</strong></a>
      <a href="/#contact"><span>Next step</span><strong>Let's connect →</strong></a>
    </nav>
  </article>
</BaseLayout>

<style>
  .project-page {
    --button-accent: var(--project-accent);
  }

  .project-hero {
    padding-block: clamp(42px, 7vw, 96px) clamp(70px, 10vw, 130px);
  }

  .back-link {
    display: inline-flex;
    gap: 0.5rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
    color: var(--ink-muted);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--project-accent);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.85fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  :global(.project-page .eyebrow) {
    color: var(--project-accent);
  }

  h1 {
    max-width: 820px;
    margin-bottom: 1.8rem;
    font-size: clamp(3rem, 7vw, 6.7rem);
  }

  .hero-description {
    max-width: 720px;
    margin-bottom: 2rem;
    color: var(--ink-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  :global(.project-page .button-primary) {
    border-color: var(--project-accent);
    background: var(--project-accent);
  }

  .hero-visual {
    min-width: 0;
  }

  .stats-band {
    border-block: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.025);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  :global(.stat) {
    min-width: 0;
    padding: 2rem clamp(1rem, 3vw, 2.4rem);
    border-left: 1px solid var(--line);
  }

  :global(.stat:last-child) {
    border-right: 1px solid var(--line);
  }

  :global(.stat strong) {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--project-accent);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.7rem);
    font-weight: 500;
    line-height: 1;
  }

  :global(.stat span) {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .project-body {
    padding-block: clamp(76px, 11vw, 150px);
  }

  :global(.project-section) {
    display: grid;
    grid-template-columns: minmax(180px, 0.34fr) minmax(0, 0.66fr);
    gap: clamp(2rem, 7vw, 7rem);
    padding-block: clamp(3.2rem, 7vw, 6rem);
    border-top: 1px solid var(--line);
  }

  :global(.project-section:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  :global(.project-section > div) {
    min-width: 0;
  }

  :global(.project-section h2) {
    margin-bottom: 1rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :global(.project-section .section-number) {
    display: block;
    margin-bottom: 0.8rem;
    color: var(--project-accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  :global(.project-section .body-copy) {
    max-width: 760px;
  }

  :global(.project-section .body-copy > p:first-child) {
    color: var(--ink);
    font-size: clamp(1.35rem, 2.8vw, 2.1rem);
    line-height: 1.42;
  }

  :global(.project-section p),
  :global(.project-section li) {
    color: var(--ink-muted);
  }

  :global(.project-section li + li) {
    margin-top: 0.55rem;
  }

  :global(.project-section strong) {
    color: var(--ink);
  }

  :global(.callout) {
    padding: clamp(1.5rem, 4vw, 2.4rem);
    margin-top: 2rem;
    border: 1px solid color-mix(in srgb, var(--project-accent) 35%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--project-accent) 6%, transparent);
  }

  :global(.callout strong) {
    color: var(--project-accent);
  }

  .project-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-bottom: clamp(80px, 10vw, 140px);
  }

  .project-nav a {
    display: grid;
    gap: 0.45rem;
    padding: 2rem;
    border: 1px solid var(--line);
    text-decoration: none;
  }

  .project-nav a:first-child {
    border-radius: var(--radius) 0 0 var(--radius);
  }

  .project-nav a:last-child {
    border-radius: 0 var(--radius) var(--radius) 0;
    text-align: right;
  }

  .project-nav a:hover {
    background: rgba(255, 255, 255, 0.035);
  }

  .project-nav span {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-nav strong {
    font-size: 1.1rem;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      max-width: 620px;
    }

    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }

    :global(.stat:nth-child(3)) {
      border-top: 1px solid var(--line);
    }

    :global(.stat:nth-child(4)) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 700px) {
    :global(.project-section) {
      grid-template-columns: 1fr;
    }

    .project-nav {
      grid-template-columns: 1fr;
    }

    .project-nav a:first-child {
      border-radius: var(--radius) var(--radius) 0 0;
    }

    .project-nav a:last-child {
      border-radius: 0 0 var(--radius) var(--radius);
      text-align: left;
    }
  }
</style>
