---
interface Props {
  index: string;
  emoji: string;
  title: string;
  summary: string;
  href: string;
  repo: string;
  live?: string;
  liveLabel?: string;
  caseLabel?: string;
  accent: string;
  skills: string[];
}

const {
  index,
  emoji,
  title,
  summary,
  href,
  repo,
  live,
  liveLabel = "View live project",
  caseLabel = "Read the case study",
  accent,
  skills,
} = Astro.props;
const hrefExternal = href.startsWith("https://");
const liveExternal = live?.startsWith("https://");
---

<article class="project-card" style={`--project-accent: ${accent}`}>
  <div class="project-preview">
    <slot name="preview" />
  </div>

  <div class="project-copy">
    <div class="project-meta">
      <span>{index}</span>
      <span>{emoji}</span>
    </div>
    <h3><a href={href} target={hrefExternal ? "_blank" : undefined} rel={hrefExternal ? "noreferrer" : undefined}>{title}</a></h3>
    <p>{summary}</p>
    <ul class="chip-list" aria-label={`${title} technologies`}>
      {skills.map((skill) => <li class="chip">{skill}</li>)}
    </ul>
    <div class="project-links">
      {
        live ? (
          <a class="case-link" href={live} target={liveExternal ? "_blank" : undefined} rel={liveExternal ? "noreferrer" : undefined}>
            {liveLabel} <span aria-hidden="true">{liveExternal ? "↗" : "→"}</span>
          </a>
        ) : (
          <a class="case-link" href={href} target={hrefExternal ? "_blank" : undefined} rel={hrefExternal ? "noreferrer" : undefined}>
            {caseLabel} <span aria-hidden="true">{hrefExternal ? "↗" : "→"}</span>
          </a>
        )
      }
      <a class="repo-link" href={repo} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    min-height: 520px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--panel);
    box-shadow: var(--shadow);
  }

  .project-card + .project-card {
    margin-top: 32px;
  }

  .project-preview {
    position: relative;
    display: grid;
    min-height: 410px;
    overflow: hidden;
    border-right: 1px solid var(--line);
    background:
      radial-gradient(circle at 30% 18%, color-mix(in srgb, var(--project-accent) 25%, transparent), transparent 42%),
      #0a0e18;
    place-items: center;
  }

  .project-preview::after {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--project-accent) 20%, transparent);
    border-radius: inherit;
    content: "";
    pointer-events: none;
  }

  .project-copy {
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 5vw, 4rem);
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: auto;
    color: var(--project-accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  h3 {
    margin: 3.5rem 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--project-accent);
  }

  p {
    margin-bottom: 1.6rem;
    color: var(--ink-muted);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.8rem;
    margin-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .case-link,
  .repo-link {
    color: var(--project-accent);
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
  }

  .repo-link {
    color: var(--ink-muted);
  }

  @media (max-width: 880px) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .project-preview {
      min-height: 360px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .project-meta {
      margin-bottom: 0;
    }

    h3 {
      margin-top: 2.4rem;
    }
  }

  @media (max-width: 520px) {
    .project-preview {
      min-height: 300px;
    }
  }
</style>
